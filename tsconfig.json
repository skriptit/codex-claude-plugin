{
  "compilerOptions": {
    "target": "ES2024", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "verbatimModuleSyntax": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noImplicitOverride": true,
    "rootDir": "src", "outDir": "dist", "declaration": true, "newLine": "lf",
    "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
